{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ethicsandai-content-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PREVIEW_ORIGIN": "https://preview.ethicsandai.your-digital-life.org",
    "MEDIA_CALLBACK_URL": "https://auth.ethicsandai.your-digital-life.org/v1/media:processorCallback",
    "MEDIA_JOBS_DLQ_NAME": "ai-ethics-media-jobs-dlq",
    "RELEASE_JOBS_DLQ_NAME": "ai-ethics-release-jobs-dlq",
    "RUNTIME_FLAGS_ENFORCED": "1"
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "ai-ethics-content",
      "database_id": "1f82c4fa-228b-4cf7-9b40-ff10eebeadfb",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    { "binding": "PUBLIC_READER_DELIVERY", "service": "ethicsandai", "entrypoint": "DeliveryIdentity" },
    { "binding": "AUTH_CAPABILITY", "service": "ethicsandai-editor-auth", "entrypoint": "AgentCapabilityVerifier" }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_MEDIA",
      "bucket_name": "ai-ethics-content-media"
    },
    {
      "binding": "UPLOAD_QUARANTINE",
      "bucket_name": "ai-ethics-upload-quarantine"
    },
    {
      "binding": "CONTENT_SNAPSHOTS",
      "bucket_name": "ai-ethics-snapshots"
    },
    {
      "binding": "RELEASE_ARTIFACTS",
      "bucket_name": "ai-ethics-release-artifacts"
    },
    {
      "binding": "CONTENT_BACKUPS",
      "bucket_name": "ai-ethics-backups"
    },
    {
      "binding": "MEDIA_JOB_ENVELOPES",
      "bucket_name": "ai-ethics-media-job-envelopes"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "MEDIA_JOBS", "queue": "ai-ethics-media-jobs" },
      { "binding": "RELEASE_JOBS", "queue": "ai-ethics-release-jobs" }
    ]
  }
}
