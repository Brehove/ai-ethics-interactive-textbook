{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ethicsandai-editor-auth",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "auth.ethicsandai.your-digital-life.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  },
  "services": [
    { "binding": "CONTENT_API", "service": "ethicsandai-content-api" }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_STATE_DB",
      "database_name": "ai-ethics-editor-auth-state",
      "database_id": "acb19231-3ceb-4cdf-b22e-f70286c65d00",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "consumers": [
      { "queue": "ai-ethics-media-jobs", "max_retries": 3, "dead_letter_queue": "ai-ethics-media-jobs-dlq" }
    ]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "EDITOR_REPO_OWNER": "Brehove",
    "EDITOR_REPO_NAME": "ai-ethics-interactive-textbook",
    "EDITOR_DEFAULT_BRANCH": "main",
    "EDITOR_ALLOWED_ORIGINS": "https://editor.ethicsandai.your-digital-life.org",
    "EDITOR_AUTH_BASE_URL": "https://auth.ethicsandai.your-digital-life.org",
    "EDITOR_ADMIN_URL": "https://editor.ethicsandai.your-digital-life.org",
    "EDITOR_CAPABILITY_VERIFICATION_URL": "https://editor.ethicsandai.your-digital-life.org/agent-access",
    "EDITOR_ALLOWED_GITHUB_USER_IDS": "6131690",
    "GITHUB_APP_ID": "4457994",
    "GITHUB_APP_CLIENT_ID": "Iv23lixEZCSxiMYDjI8r",
    "GITHUB_APP_INSTALLATION_ID": "150592311",
    "EDITOR_STATE_TTL_SECONDS": "600",
    "EDITOR_SESSION_TTL_SECONDS": "3600",
    "EDITOR_CONTENT_SCOPES": "content:read content:write content:submit content:approve media:upload"
  }
}
