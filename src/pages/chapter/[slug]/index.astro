---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import ReaderShell from "../../../components/ReaderShell.astro";
import ReadingRecord from "../../../components/ReadingRecord.astro";
import InlineScholarFigures from "../../../components/InlineScholarFigures.astro";
import InlineArtifacts from "../../../components/InlineArtifacts.astro";
import InlineConceptDiagrams from "../../../components/InlineConceptDiagrams.astro";
import { getChapterArtifacts, getChapterSlugs, requireChapter } from "../../../lib/content";
import { resolveChapterPeople } from "../../../lib/scholarly-layer";
import { getChapterDiagrams } from "../../../lib/chapter-diagrams";

export async function getStaticPaths() {
  return (await getChapterSlugs()).map((slug) => ({ params: { slug } }));
}

const chapter = await requireChapter(Astro.params.slug!);
const { meta, Content, headings, world, sourceLinks, readingRecord, previous, next } = chapter;
const chapterPeople = await resolveChapterPeople(world);
const chapterArtifacts = await getChapterArtifacts(meta.id);
const chapterDiagrams = getChapterDiagrams(meta.id);
---

<SiteLayout
  title={meta.title}
  description={meta.description}
  chapterNumber={meta.order}
  canonicalPath={meta.path}
  readingRecordPilot={meta.id === "ch07"}
>
  <ReaderShell
    slug={meta.slug}
    title={meta.title}
    partTitle={meta.part.title}
    chapterNumber={meta.order}
    readingMinutes={meta.readingMinutes}
    headings={headings}
    active="first"
    previous={previous}
    next={next}
  >
    <div class="chapter-prose first-read">
      <Content />
      <InlineConceptDiagrams diagrams={chapterDiagrams} />
      <InlineArtifacts artifacts={chapterArtifacts} />
      <InlineScholarFigures people={chapterPeople} primarySources={sourceLinks.primarySources} />
    </div>
    <ReadingRecord
      slot="scholarly-dock"
      chapterNumber={meta.order}
      chapterTitle={meta.title}
      chapterPath={meta.path}
      chapterVersion={meta.websiteBaseline.canonicalMarkdownSha256.slice(0, 12)}
      prompts={readingRecord.checkpoints}
      activityPreview={meta.id === "ch07"}
    />
  </ReaderShell>
</SiteLayout>

<style>
  .first-read :global(h1) { margin-top: 0.3rem; }
</style>
