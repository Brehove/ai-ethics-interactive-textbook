---
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import ReaderShell from "../../../../components/ReaderShell.astro";
import LayerIntro from "../../../../components/LayerIntro.astro";
import ScholarlyDock from "../../../../components/ScholarlyDock.astro";
import InlineScholarFigures from "../../../../components/InlineScholarFigures.astro";
import InlineArtifacts from "../../../../components/InlineArtifacts.astro";
import InlineConceptDiagrams from "../../../../components/InlineConceptDiagrams.astro";
import { getChapterArtifacts, getChapterSlugs, requireChapter } from "../../../../lib/content";
import { resolveChapterPeople } from "../../../../lib/scholarly-layer";
import { getChapterDiagrams } from "../../../../lib/chapter-diagrams";

export async function getStaticPaths() {
  return (await getChapterSlugs()).map((slug) => ({ params: { slug } }));
}

const chapter = await requireChapter(Astro.params.slug!);
const { meta, Content, headings, annotations, world, sourceLinks, previous, next } = chapter;
const annotationItems = Array.isArray(annotations?.items) ? annotations.items : [];
const chapterPeople = await resolveChapterPeople(world);
const chapterArtifacts = await getChapterArtifacts(meta.id);
const chapterDiagrams = getChapterDiagrams(meta.id);
---

<SiteLayout title={`Deep Read · ${meta.title}`} description={`Argument, objection, and judgment layer for ${meta.title}.`} chapterNumber={meta.order} canonicalPath={`${meta.path}deep/`}>
  <ReaderShell
    slug={meta.slug}
    title={meta.title}
    partTitle={meta.part.title}
    chapterNumber={meta.order}
    readingMinutes={meta.readingMinutes}
    headings={headings}
    active="deep"
    pressbooksUrl={meta.pressbooksUrl}
    previous={previous}
    next={next}
  >
    <LayerIntro eyebrow="Deep Read" title="The structure beneath the prose" description="This route keeps the complete chapter visible while exposing concepts, inferences, objections, and places where your own judgment must do work." />
    {annotationItems.length > 0 && (
      <aside class="annotation-index" aria-labelledby="annotation-index-title">
        <h2 id="annotation-index-title">Argument notes</h2>
        <ol>
          {annotationItems.map((item: any) => <li><a href={`#${item.passageId ?? item.passage_id}`}>{item.title ?? item.label ?? item.id}</a></li>)}
        </ol>
      </aside>
    )}
    <div class="chapter-prose deep-layer">
      <Content />
      <InlineConceptDiagrams diagrams={chapterDiagrams} />
      <InlineArtifacts artifacts={chapterArtifacts} />
      <InlineScholarFigures people={chapterPeople} primarySources={sourceLinks.primarySources} />
    </div>
    <ScholarlyDock
      slot="scholarly-dock"
      slug={meta.slug}
      active="deep"
      people={chapterPeople}
      primarySources={sourceLinks.primarySources}
      pressbooksUrl={meta.pressbooksUrl}
      inlineFeatured
    />
  </ReaderShell>
</SiteLayout>

<style>
  .annotation-index { max-width: var(--content-width); margin: 1.5rem 0; padding: 1rem 1.2rem; border: 1px solid var(--line); background: var(--wash); }
  .annotation-index h2 { margin: 0 0 0.6rem; font: 700 0.75rem/1.3 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; }
  .annotation-index ol { margin: 0; padding-left: 1.2rem; }
  .deep-layer { padding-top: 1.5rem; border-top: 2px solid var(--ink); }
  .deep-layer :global(h1) { font-size: clamp(2rem, 4vw, 3rem); }
</style>
