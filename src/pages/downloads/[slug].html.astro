---
import { getChapterSlugs, requireChapter } from "../../lib/content";

export async function getStaticPaths() {
  return (await getChapterSlugs()).map((slug) => ({ params: { slug } }));
}

const chapter = await requireChapter(Astro.params.slug!);
const { meta, Content } = chapter;
const canonical = new URL(meta.path, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`Offline reading copy of ${meta.title}.`} />
    <title>{meta.title} · PHIL 123 offline copy</title>
    <style is:inline>
      :root { --ink:#102b4a; --soft:#44576b; --paper:#fffdf7; --line:#b5c3c7; --wash:#e8f0f2; --rust:#7c2d18; }
      * { box-sizing:border-box; }
      body { margin:0; padding:clamp(1rem,5vw,4rem); background:var(--paper); color:var(--ink); font:18px/1.65 Georgia,"Times New Roman",serif; }
      main { max-width:48rem; margin:auto; }
      header { margin-bottom:3rem; padding-bottom:1rem; border-bottom:1px solid var(--line); }
      header p { margin:.3rem 0; color:var(--soft); font:700 .72rem/1.4 Arial,sans-serif; letter-spacing:.08em; text-transform:uppercase; }
      h1 { font-size:clamp(2.5rem,7vw,4.7rem); line-height:1; letter-spacing:-.045em; font-weight:500; }
      h2 { margin-top:2.6rem; font-size:1.8rem; line-height:1.2; font-weight:500; }
      h3 { margin-top:2rem; }
      a { color:inherit; text-underline-offset:.18em; }
      aside { margin:2rem 0; padding:1.2rem; border-left:3px solid var(--rust); background:#f7eed5; }
      table { width:100%; border-collapse:collapse; font: .9rem/1.4 Arial,sans-serif; }
      th,td { padding:.6rem; border:1px solid var(--line); text-align:left; vertical-align:top; }
      th { background:var(--wash); }
      footer { margin-top:4rem; padding-top:1.5rem; border-top:1px solid var(--line); color:var(--soft); font:.8rem/1.5 Arial,sans-serif; }
      @media print { @page { margin:.7in; } body { padding:0; background:white; color:black; font-size:11.5pt; } a[href^="http"]::after { content:" (" attr(href) ")"; font:8.5pt/1.3 Arial,sans-serif; } h2,h3 { break-after:avoid; } aside,table { break-inside:avoid; } }
    </style>
  </head>
  <body>
    <main>
      <header>
        <p>PHIL 123 · AI &amp; Ethics · Chapter {meta.order} of 18</p>
        <p>Offline reading copy · canonical web edition: <a href={canonical}>{canonical}</a></p>
      </header>
      <Content />
      <footer>
        <p>Original textbook prose is licensed under CC BY 4.0 unless an item says otherwise. Third-party materials retain their recorded rights.</p>
        <p>This static file creates no account, sends no reading data, and does not update automatically. Return to the canonical address for corrections and the other reading layers.</p>
      </footer>
    </main>
  </body>
</html>
