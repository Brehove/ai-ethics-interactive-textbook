---
import SiteLayout from "../layouts/SiteLayout.astro";
import PrivacyNote from "../components/PrivacyNote.astro";
import { getChapterSummaries } from "../lib/content";

const chapters = await getChapterSummaries();
const featured = chapters.slice(0, 3);
---

<SiteLayout
  title="Interactive textbook"
  description="A free, open, interactive textbook for philosophical judgment about AI and ethics."
  pageClass="landing-page"
>
  <main id="main-content">
    <section class="cover" aria-labelledby="cover-title">
      <span class="visually-hidden">A Piranesi-inspired impossible architecture layers classical, medieval, industrial, and cybernetic forms beneath a luminous oculus.</span>
      <div class="cover-title">
        <h1 id="cover-title">AI &amp; Ethics</h1>
        <p class="cover-subtitle">An interactive textbook</p>
        <p class="cover-question">How should we live with intelligent machines?</p>
        <a class="begin-reading" href={chapters[0]?.path ?? "/contents/"}>
          <span>Begin reading</span><b aria-hidden="true">⟶</b>
        </a>
      </div>
    </section>

    <section class="book-intro site-width" aria-labelledby="book-intro-title">
      <div class="intro-statement">
        <p class="eyebrow">A reader for philosophical judgment</p>
        <h2 id="book-intro-title">Read the argument. Let the passage open its context. Decide what you believe.</h2>
        <p>The chapter is the center of the experience. Primary texts, people, visual evidence, and judgment exercises appear only when a particular passage makes them useful.</p>
      </div>
      <ol class="reading-approach" aria-label="Reading approach">
        <li><span>01</span><div><b>Chapter first</b><small>Sustained philosophical prose</small></div></li>
        <li><span>02</span><div><b>Context when it matters</b><small>Passage-led sources, people, and visual evidence</small></div></li>
        <li><span>03</span><div><b>Judgment stays yours</b><small>Prompts ask for a response, not a parallel reading mode</small></div></li>
      </ol>
    </section>

    <section class="featured site-width" aria-labelledby="featured-title">
      <div class="section-head">
        <p class="eyebrow">The opening movement</p>
        <h2 id="featured-title">Learn to see the argument before asking AI to improve it.</h2>
      </div>
      <div class="chapter-list">
        {featured.map((chapter) => (
          <article>
            <p class="chapter-number">{String(chapter.order).padStart(2, "0")}</p>
            <div>
              <p class="eyebrow">{chapter.part.title}</p>
              <h3><a href={chapter.path}>{chapter.title}</a></h3>
              <p>{chapter.description}</p>
            </div>
            <p class="chapter-meta">{chapter.readingMinutes} min</p>
          </article>
        ))}
      </div>
      <div class="all-chapters"><a href="/contents/">Open all {chapters.length} chapters <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="book-contract">
      <div class="site-width contract-inner">
        <div>
          <p class="eyebrow">Keep a copy</p>
          <h2>Print it. Save it as PDF. Download the chapter.</h2>
          <p>Required readings do not depend on a proprietary app or a permanent internet connection.</p>
        </div>
        <PrivacyNote />
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .cover {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    place-items: end center;
    overflow: hidden;
    border: var(--frame-size) solid var(--frame);
    border-top: 0;
    background:
      linear-gradient(180deg, transparent 0 56%, rgb(0 0 0 / 18%) 70%, rgb(0 0 0 / 92%) 100%),
      url("/images/piranesi-oculus-hero.webp") center top / cover no-repeat,
      var(--frame);
  }
  .cover-title { position: relative; z-index: 2; width: min(100% - 2rem, 48rem); padding: 0 1rem clamp(2.1rem, 5vw, 4.5rem); color: #e4d7c0; text-align: center; text-shadow: 0 2px 18px #000; }
  .cover h1 { margin: 0; font-size: clamp(4rem, 8vw, 7.3rem); font-weight: 400; line-height: 0.92; letter-spacing: -0.045em; }
  .cover-subtitle { margin: 0.7rem 0 0; color: #c6a16c; font-size: clamp(1.15rem, 2.2vw, 1.65rem); font-style: italic; }
  .cover-question { margin: 0.25rem 0 1.4rem; color: #c9bdab; font-size: clamp(0.9rem, 1.5vw, 1.1rem); }
  .begin-reading { display: inline-grid; grid-template-columns: 1fr; justify-items: center; gap: 0.25rem; color: #d5b985; font-size: 1rem; text-decoration: none; }
  .begin-reading b { width: 9rem; overflow: hidden; font-weight: 400; letter-spacing: 0.05em; }
  .begin-reading:hover { color: #fff0cc; }
  .book-intro, .featured { background: var(--paper-light); }
  .book-intro { width: min(100% - 2 * var(--frame-size), 100%); display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr); gap: clamp(3rem, 9vw, 9rem); padding: clamp(4rem, 9vw, 8rem) clamp(1.5rem, 7vw, 7rem); }
  .intro-statement h2, .section-head h2 { margin: 0.7rem 0 1rem; font-size: clamp(2.5rem, 5vw, 5.2rem); font-weight: 400; line-height: 0.98; letter-spacing: -0.045em; }
  .intro-statement > p:last-child { max-width: 47rem; color: var(--ink-soft); font-size: 1.05rem; }
  .reading-approach { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .reading-approach li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.75rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .reading-approach span { color: var(--rust); font: 700 0.67rem/1.4 var(--sans); }
  .reading-approach b { display: block; font-weight: 500; }
  .reading-approach small { display: block; color: var(--ink-soft); font: 0.7rem/1.4 var(--sans); }
  .featured { width: min(100% - 2 * var(--frame-size), 100%); padding: 0 clamp(1.5rem, 7vw, 7rem) clamp(5rem, 9vw, 8rem); }
  .section-head { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: start; border-top: 1px solid var(--ink); padding-top: 1.5rem; }
  .section-head h2 { max-width: 20ch; margin-top: 0; font-size: clamp(2rem, 4vw, 3.7rem); }
  .chapter-list { margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .chapter-list article { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .chapter-number, .chapter-meta { margin: 0; color: var(--rust); font: 700 0.68rem/1.5 var(--sans); }
  .chapter-list h3 { margin: 0.35rem 0 0.4rem; font-size: 1.65rem; font-weight: 500; line-height: 1.15; }
  .chapter-list h3 a { text-decoration: none; }
  .chapter-list article > div > p:last-child { max-width: 52rem; margin: 0; color: var(--ink-soft); font-size: 0.84rem; }
  .all-chapters { margin-top: 2rem; text-align: right; }
  .all-chapters a { color: var(--rust-dark); font-size: 0.9rem; }
  .book-contract { margin: 0 var(--frame-size) var(--frame-size); padding-block: 4rem; background: var(--paper-deep); }
  .contract-inner { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 8vw, 8rem); align-items: center; }
  .contract-inner h2 { max-width: 19ch; margin: 0.5rem 0; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; line-height: 1.05; }
  @media (max-width: 820px) {
    .cover { min-height: 78svh; background-position: 50% top; }
    .book-intro, .section-head, .contract-inner { grid-template-columns: 1fr; }
    .book-intro, .featured { padding-inline: 1.35rem; }
    .chapter-list article { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .chapter-meta { grid-column: 2; }
  }
</style>
