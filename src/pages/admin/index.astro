---
import SiteLayout from "../../layouts/SiteLayout.astro";

const target = "https://auth.ethicsandai.your-digital-life.org/auth/start?chapter=what-are-you-becoming-aristotle-character-and-ai-assisted-life&mode=edit";
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Refresh", `0; url=${target}`);
---

<SiteLayout title="Opening the chapter editor" description="Instructor-only authoring redirect." noindex>
  <main class="container" style="padding-block: 5rem;">
    <h1>Opening the chapter editor…</h1>
    <p><a href={target}>Continue to the secure editor</a></p>
  </main>
</SiteLayout>
