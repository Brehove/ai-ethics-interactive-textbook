---
interface Props {
  slug: string;
  active: "first" | "deep" | "sources" | "world";
}
const { slug, active } = Astro.props;
const modes = [
  ["first", "First Read", `/chapter/${slug}/`],
  ["deep", "Deep Read", `/chapter/${slug}/deep/`],
  ["sources", "Sources", `/chapter/${slug}/sources/`],
  ["world", "World", `/chapter/${slug}/world/`],
] as const;
---

<nav class="mode-nav" aria-label="Reading mode">
  {modes.map(([id, label, href]) => (
    <a href={href} aria-current={active === id ? "page" : undefined}>{label}</a>
  ))}
</nav>

<style>
  .mode-nav {
    display: flex;
    gap: clamp(1rem, 4vw, 2.5rem);
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
    background: var(--paper-light);
  }
  a {
    flex: 0 0 auto;
    padding: 0.9rem 0.1rem 0.72rem;
    border-bottom: 3px solid transparent;
    color: var(--ink);
    font: 700 0.68rem/1 var(--sans);
    letter-spacing: 0.15em;
    text-decoration: none;
    text-transform: uppercase;
  }
  a[aria-current="page"] { border-color: var(--ink); }
</style>
