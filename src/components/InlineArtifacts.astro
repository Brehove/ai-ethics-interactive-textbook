---
import type { ChapterArtifact } from "../lib/content";

interface Props { artifacts: ChapterArtifact[]; }
const { artifacts } = Astro.props;
---

{artifacts.length > 0 && (
  <section class="inline-artifact-gallery" data-inline-artifact-gallery aria-label="Visual evidence in this chapter">
    {artifacts.map((artifact) => (
      <figure class="inline-artifact" data-inline-artifact data-passage-ids={artifact.placement.passageIds.join(",")}>
        <a class="artifact-image-link" href={artifact.source.pageUrl} rel="noreferrer" aria-label={`Open the Wikimedia Commons record for ${artifact.title}`}>
          <img src={artifact.localPath} width={artifact.width} height={artifact.height} alt={artifact.alt} loading="lazy" decoding="async" />
        </a>
        <figcaption>
          <p class="artifact-type">{artifact.artifactType?.replaceAll("-", " ") ?? "visual source"}</p>
          <h3>{artifact.title}</h3>
          {artifact.caption && <p class="artifact-caption">{artifact.caption}</p>}
          <details>
            <summary>Read the image</summary>
            <div class="artifact-note">
              <p>{artifact.teachingUse}</p>
              <p><strong>Source and rights.</strong> {artifact.rights.artist}. {artifact.rights.licenseUrl ? <a href={artifact.rights.licenseUrl} rel="license noreferrer">{artifact.rights.licenseShortName}</a> : artifact.rights.licenseShortName}. <a href={artifact.source.pageUrl} rel="noreferrer">Commons record</a>, reviewed revision {artifact.source.revisionId}. Modified: {artifact.derivative.modification}.</p>
            </div>
          </details>
          <p class="print-artifact-credit">Image: {artifact.rights.artist}. {artifact.rights.licenseShortName}. {artifact.source.pageUrl}</p>
        </figcaption>
      </figure>
    ))}
  </section>
)}

<script>
  const sharedPassage = (artifact: HTMLElement, thinker: HTMLElement): boolean => {
    if (thinker.classList.contains("chapter-person")) return true;
    const artifactPassages = new Set(artifact.dataset.passageIds?.split(",").map((id) => id.trim()).filter(Boolean));
    return thinker.dataset.passageIds?.split(",").map((id) => id.trim()).filter(Boolean)
      .some((id) => artifactPassages.has(id)) ?? false;
  };

  const pairWithAdjacentThinker = (artifact: HTMLElement): void => {
    if (artifact.closest("[data-inline-card-pair]")) return;
    const selector = ".chapter-person, [data-inline-scholar-card][data-inline-placed]";
    const previous = artifact.previousElementSibling;
    const next = artifact.nextElementSibling;
    const thinker = next?.matches(selector) ? next : previous?.matches(selector) ? previous : null;
    if (!(thinker instanceof HTMLElement) || !sharedPassage(artifact, thinker)) return;

    const pair = document.createElement("div");
    pair.className = "inline-card-pair";
    pair.dataset.inlineCardPair = "true";
    artifact.before(pair);
    pair.append(artifact, thinker);
  };

  const placeInlineArtifacts = (): void => {
    document.querySelectorAll<HTMLElement>("[data-inline-artifact-gallery]").forEach((gallery) => {
      const prose = gallery.closest<HTMLElement>(".chapter-prose");
      if (!prose) return;
      // Schema-v4 projections own card membership and layout explicitly. The
      // legacy gallery remains only as a pre-cutover fallback; allowing it to
      // move figures into a v4 flow would duplicate cards and override the
      // server-rendered reading order.
      if (prose.querySelector(".chapter-flow[data-layout-catalog-version]")) {
        gallery.remove();
        return;
      }
      const figures = [...gallery.querySelectorAll<HTMLElement>("[data-inline-artifact]")];
      figures.forEach((figure) => {
        const target = figure.dataset.passageIds?.split(",").map((id) => id.trim()).filter(Boolean)
          .map((id) => prose.querySelector<HTMLElement>(`#${CSS.escape(id)}`)).find(Boolean);
        if (!target) return;
        let insertionPoint: Element = target;
        while (insertionPoint.nextElementSibling?.matches("[data-inline-artifact][data-inline-placed], [data-inline-scholar-card][data-inline-placed]")) {
          insertionPoint = insertionPoint.nextElementSibling;
        }
        figure.dataset.inlinePlaced = "true";
        insertionPoint.insertAdjacentElement("afterend", figure);
      });
      figures.filter((figure) => figure.dataset.inlinePlaced === "true").forEach(pairWithAdjacentThinker);
      if (gallery.childElementCount === 0) gallery.remove();
    });
  };
  placeInlineArtifacts();
</script>

<style>
  .inline-artifact-gallery { margin: 2.5rem 0; }
  .inline-artifact-gallery:empty { display: none; }
  .inline-artifact {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(13rem, 0.65fr);
    margin: 2.4rem 0 3rem;
    border-block: 1px solid var(--line-dark);
    background: var(--wash);
    break-inside: avoid;
  }
  .artifact-image-link { display: grid; min-height: 18rem; place-items: center; padding: 1rem; border-right: 1px solid var(--line); background: var(--paper); }
  .artifact-image-link img { display: block; max-width: 100%; max-height: 34rem; width: auto; height: auto; object-fit: contain; }
  figcaption { align-self: center; padding: clamp(1.2rem, 3vw, 2rem); }
  .artifact-type { margin: 0; color: var(--rust-dark); font: 700 0.62rem/1.35 var(--sans); letter-spacing: 0.13em; text-transform: uppercase; }
  h3 { margin: 0.35rem 0 0.7rem; font-size: clamp(1.55rem, 3vw, 2.35rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.025em; }
  .artifact-caption { margin: 0 0 1rem; color: var(--ink-soft); font-size: 0.93rem; line-height: 1.5; }
  details { border-top: 1px solid var(--line); font-family: var(--sans); }
  summary { display: flex; min-height: 2.65rem; align-items: center; justify-content: space-between; color: var(--ink); font: 700 0.68rem/1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  summary::after { content: "+"; color: var(--rust-dark); font-size: 1rem; }
  details[open] > summary::after { content: "−"; }
  .artifact-note { padding: 0.2rem 0 0.8rem; color: var(--ink-soft); font: 0.78rem/1.55 var(--sans); }
  .artifact-note p { margin: 0 0 0.7rem; }
  .artifact-note a { color: var(--rust-dark); font-weight: 700; overflow-wrap: anywhere; }
  .print-artifact-credit { display: none; }

  :global(.chapter-person) {
    container-type: inline-size;
    margin: 2rem 0;
    border-left: 4px solid var(--rust);
    background: var(--wash-strong);
    padding: clamp(1rem, 3vw, 2rem);
    break-inside: avoid;
  }
  :global(.chapter-person__content) {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
  }
  :global(.chapter-person__portrait) { width: min(100%, 18rem); margin-inline: auto; }
  @container (min-width: 26rem) {
    :global(.chapter-person__content) { grid-template-columns: minmax(8rem, 34%) 1fr; }
    :global(.chapter-person__portrait) { width: auto; margin-inline: 0; }
  }
  :global(.chapter-person__portrait img) { display: block; width: 100%; height: auto; }
  :global(.chapter-person__label) {
    margin: 0;
    color: var(--rust-dark);
    font: 700 0.64rem/1.35 var(--sans);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  :global(.chapter-person__credit) { color: var(--ink-soft); font: 0.62rem/1.4 var(--sans); }

  :global(.inline-card-pair) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(0.9rem, 2vw, 1.25rem);
    margin: 2.4rem 0 3rem;
  }
  :global(.inline-card-pair > .inline-artifact),
  :global(.inline-card-pair > .chapter-person),
  :global(.inline-card-pair > .inline-scholar-card) {
    min-width: 0;
    height: 100%;
    margin: 0;
  }
  :global(.inline-card-pair > .inline-artifact) { grid-template-columns: 1fr; }
  :global(.inline-card-pair > .inline-artifact .artifact-image-link) {
    min-height: 20rem;
    max-height: 20rem;
    border-right: 0;
    border-bottom: 1px solid var(--line);
    padding: 0.75rem;
  }
  :global(.inline-card-pair > .inline-artifact .artifact-image-link img) { max-height: 18.5rem; }
  :global(.inline-card-pair > .inline-artifact figcaption) { align-self: start; padding: 1.15rem; }
  :global(.inline-card-pair > .inline-artifact h3) { font-size: clamp(1.35rem, 2.5vw, 1.7rem); }

  :global(.inline-card-pair > .chapter-person),
  :global(.inline-card-pair > .inline-scholar-card) {
    grid-template-columns: 1fr;
    gap: 0;
    overflow: hidden;
    border-block: 1px solid var(--line-dark);
    border-left: 4px solid var(--rust);
    background: var(--wash-strong);
    padding: 0;
    box-shadow: none;
  }
  :global(.inline-card-pair > .chapter-person .chapter-person__content) {
    grid-template-columns: 1fr;
    gap: 0;
  }
  :global(.inline-card-pair .chapter-person__portrait),
  :global(.inline-card-pair .inline-scholar-card__portrait) {
    min-width: 0;
    border-right: 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    padding: 0.75rem;
  }
  :global(.inline-card-pair .chapter-person__portrait img),
  :global(.inline-card-pair .inline-scholar-card__portrait .person-portrait img) {
    width: 100%;
    height: 18.5rem;
    min-height: 0;
    max-height: 18.5rem;
    border: 0;
    object-fit: cover;
    object-position: center 28%;
  }
  :global(.inline-card-pair .chapter-person__body),
  :global(.inline-card-pair .inline-scholar-card__record) { align-self: start; padding: 1.15rem; }
  :global(.inline-card-pair .chapter-person h3),
  :global(.inline-card-pair .inline-scholar-card h3) {
    margin: 0.35rem 0 0.7rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  :global(.inline-card-pair .chapter-person__body p) { margin: 0.55rem 0; font-size: 0.9rem; line-height: 1.5; }

  @media (max-width: 700px) {
    .inline-artifact { grid-template-columns: 1fr; }
    .artifact-image-link { min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .artifact-image-link img { max-height: 28rem; }
    :global(.chapter-person__content) { grid-template-columns: 1fr; }
    :global(.inline-card-pair) { grid-template-columns: 1fr; }
    :global(.inline-card-pair > .inline-artifact .artifact-image-link) { min-height: 0; max-height: none; }
    :global(.inline-card-pair > .inline-artifact .artifact-image-link img) { max-height: 28rem; }
    :global(.inline-card-pair .chapter-person__portrait img),
    :global(.inline-card-pair .inline-scholar-card__portrait .person-portrait img) {
      height: auto;
      max-height: 24rem;
      object-fit: contain;
    }
  }
  @media print {
    :global(.inline-card-pair) { display: block; }
    .inline-artifact { display: block; background: transparent; }
    .artifact-image-link { min-height: 0; border: 0; }
    :global(.chapter-person) { display: block; background: transparent; }
    :global(.inline-card-pair > .chapter-person),
    :global(.inline-card-pair > .inline-scholar-card) { margin: 1.5rem 0; }
    details { display: none; }
    .print-artifact-credit { display: block; font: 0.58rem/1.4 var(--sans); overflow-wrap: anywhere; }
  }
</style>
