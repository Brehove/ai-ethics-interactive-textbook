---
interface Props {
  chapterNumber?: number;
  chapterTotal?: number;
  readingRecordPilot?: boolean;
  readingRecordTotal?: number;
  documentId?: string;
  canonicalPath?: string;
}

const { chapterNumber, chapterTotal = 18, readingRecordPilot = false, readingRecordTotal = 0, documentId, canonicalPath = Astro.url.pathname } = Astro.props;
const authOrigin = import.meta.env.PUBLIC_EDITOR_AUTH_ORIGIN ?? "https://auth.ethicsandai.your-digital-life.org";
const chapterSlug = canonicalPath.match(/^\/chapter\/([a-z0-9]+(?:-[a-z0-9]+)*)\/?$/)?.[1];
const editorUrl = new URL("/auth/start", authOrigin);
if (chapterSlug) editorUrl.searchParams.set("chapter", chapterSlug);
editorUrl.searchParams.set("mode", "edit");
---

<header class="site-header">
  <a class="brand" href="/">AI &amp; Ethics</a>
  {chapterNumber && <p class="chapter-count" aria-label={`Chapter ${chapterNumber} of ${chapterTotal}`}>{chapterNumber} / {chapterTotal}</p>}
  <nav aria-label="Site">
    <a href="/contents/">Contents</a>
    {!chapterNumber && <a href="/instructors/reading-records/">Instructors</a>}
    {!chapterNumber && <a href="/about/">About</a>}
    {chapterNumber && readingRecordPilot && (
      <button type="button" class="record-header-button" data-open-reading-record aria-controls="context-panel" aria-expanded="false">
        <span class="record-label-wide">Reading record · <b data-header-record-progress>0/{readingRecordTotal}</b></span>
        <span class="record-label-short">Record · <b data-header-record-progress>0/{readingRecordTotal}</b></span>
      </button>
    )}
    {chapterNumber && !readingRecordPilot && <button type="button" data-open-notes>Notes</button>}
    <button type="button" class="type-toggle" data-type-toggle aria-label="Change text size">Aa</button>
    {chapterNumber && <button type="button" data-print-header>Print</button>}
    {chapterNumber && documentId && (
      <details class="chapter-menu">
        <summary aria-label="Chapter menu">•••</summary>
        <div class="chapter-menu__items">
          <a href={editorUrl.toString()} data-edit-chapter data-auth-base={editorUrl.toString()}>Edit chapter</a>
          <a href="/instructors/reading-records/">Instructor guide</a>
        </div>
      </details>
    )}
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-type-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const current = document.body.dataset.textScale ?? "normal";
      document.body.dataset.textScale = current === "normal" ? "large" : current === "large" ? "largest" : "normal";
    });
  });
  document.querySelectorAll<HTMLButtonElement>("[data-print-header]").forEach((button) => {
    button.addEventListener("click", () => window.print());
  });
  document.querySelectorAll<HTMLAnchorElement>("[data-edit-chapter]").forEach((link) => {
    link.addEventListener("click", () => {
      const target = new URL(link.dataset.authBase ?? link.href);
      const visible = [...document.querySelectorAll<HTMLElement>("main [id]")]
        .filter((element) => /^[A-Za-z][A-Za-z0-9._:-]{0,127}$/.test(element.id))
        .map((element) => ({ element, distance: Math.abs(element.getBoundingClientRect().top - 120) }))
        .sort((left, right) => left.distance - right.distance)[0]?.element;
      const anchor = visible?.id || (window.location.hash ? window.location.hash.slice(1) : "");
      if (anchor && /^[A-Za-z][A-Za-z0-9._:-]{0,127}$/.test(anchor)) target.searchParams.set("anchor", anchor);
      link.href = target.toString();
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 35;
    top: 0;
    min-height: var(--header-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: var(--frame-size) clamp(1rem, 2.6vw, 2.5rem) 0.45rem;
    border-bottom: 1px solid var(--frame-line);
    background: var(--frame);
    color: var(--paper-deep);
  }
  .brand {
    justify-self: start;
    color: var(--paper-deep);
    font: 500 1rem/1.2 var(--serif);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .brand:hover { color: var(--gold); }
  .chapter-count {
    margin: 0;
    color: var(--paper-deep);
    font: 500 0.76rem/1 var(--serif);
    letter-spacing: 0.14em;
  }
  nav { justify-self: end; display: flex; gap: 1rem; }
  nav a, nav button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--paper-deep);
    padding: 0.55rem 0.35rem;
    font: 500 0.67rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-decoration: none;
    cursor: pointer;
  }
  nav a:hover, nav button:hover { color: var(--gold); }
  .record-header-button b { font: inherit; }
  .record-label-short { display: none; }
  .chapter-menu { position: relative; }
  .chapter-menu summary {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    list-style: none;
    color: var(--paper-deep);
    cursor: pointer;
    font: 700 0.8rem/1 var(--sans);
    letter-spacing: 0.12em;
  }
  .chapter-menu summary::-webkit-details-marker { display: none; }
  .chapter-menu__items {
    position: absolute;
    right: 0;
    top: calc(100% + 0.35rem);
    width: max-content;
    min-width: 12rem;
    padding: 0.35rem;
    border: 1px solid var(--frame-line);
    background: var(--frame);
    box-shadow: 0 0.8rem 2rem rgb(5 6 6 / 16%);
  }
  .chapter-menu__items a { justify-content: flex-start; padding-inline: 0.8rem; }
  @media (max-width: 640px) {
    .site-header { grid-template-columns: 1fr auto; }
    .chapter-count { display: none; }
    nav a:first-child { display: none; }
    .brand { font-size: 0.9rem; }
    .record-label-wide { display: none; }
    .record-label-short { display: inline; }
  }
</style>
