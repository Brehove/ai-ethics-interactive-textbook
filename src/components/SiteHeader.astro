---
interface Props {
  chapterNumber?: number;
  chapterTotal?: number;
}

const { chapterNumber, chapterTotal = 18 } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/">PHIL 123 <span aria-hidden="true">/</span> AI &amp; Ethics</a>
  {chapterNumber && <p class="chapter-count" aria-label={`Chapter ${chapterNumber} of ${chapterTotal}`}>{String(chapterNumber).padStart(2, "0")} / {chapterTotal}</p>}
  <nav aria-label="Site">
    <a href="/contents/">Contents</a>
    <a href="/about/">About</a>
  </nav>
</header>

<style>
  .site-header {
    min-height: 4.2rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
    background: rgb(247 244 236 / 96%);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .brand {
    justify-self: start;
    color: var(--ink);
    font: 600 1rem/1.2 var(--serif);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .brand span { color: var(--rust); padding-inline: 0.45rem; }
  .chapter-count {
    margin: 0;
    font: 700 0.74rem/1 var(--sans);
    letter-spacing: 0.14em;
  }
  nav { justify-self: end; display: flex; gap: 1rem; }
  nav a {
    padding-block: 0.3rem;
    border-bottom: 1px solid var(--line-dark);
    font: 700 0.68rem/1 var(--sans);
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .site-header { grid-template-columns: 1fr auto; min-height: 3.8rem; }
    .chapter-count { display: none; }
    nav a:first-child { display: none; }
    .brand { font-size: 0.9rem; }
  }
</style>
