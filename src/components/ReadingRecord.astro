  .export-actions--pilot { grid-template-columns: 1fr; }
  .copy-button { min-height: 2.75rem; border: 1px solid var(--ink); background: transparent; color: var(--ink); padding: 0.75rem; font: 700 var(--record-tiny)/1.3 var(--sans); cursor: pointer; }
  .student-name { display: grid; gap: 0.4rem; margin-bottom: 0.85rem; }
