  .preserved-response { padding: 1rem 0 0; }
  .preserved-response:focus { outline: 2px solid var(--rust); outline-offset: 4px; }
  .preserved-label { margin: 0; color: #315d48; font: 700 var(--record-tiny)/1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; }
  .preserved-movement { margin: 0.7rem 0 0; color: #315d48; font: 700 var(--record-tiny)/1.35 var(--sans); }
  .preserved-response blockquote { margin: 0.8rem 0; border-left: 2px solid var(--gold); padding: 0.15rem 0 0.15rem 1rem; font-size: 0.95rem; line-height: 1.55; white-space: pre-wrap; }
  .preserved-response > p:last-child { color: var(--ink-soft); font: var(--record-small)/1.45 var(--sans); }
  .return-link { display: flex; min-height: 2.75rem; align-items: center; justify-content: space-between; margin-top: 1.3rem; border-top: 1px solid var(--line); padding-top: 0.8rem; color: var(--rust-dark); font: 700 var(--record-small)/1.3 var(--sans); text-decoration: none; }
  .record-export { margin-top: 1.8rem; padding-top: 1.25rem; border-top: 1px solid var(--line-dark); }
