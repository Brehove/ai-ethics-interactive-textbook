  .record-map details p { margin: 0 0 0.4rem; padding: 0.7rem 0.8rem; border-left: 2px solid #6f8da4; background: #eef1f2; font-size: 0.84rem; line-height: 1.5; }
  .record-prompt { padding-top: 1.4rem; }
  .prompt-stage, .dialog-kicker { margin: 0; color: var(--rust); font: 700 var(--record-tiny)/1.3 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; }
  .record-prompt h2 { margin: 0.45rem 0 0; font-size: clamp(1.55rem, 2.3vw, 2rem); font-weight: 400; line-height: 1.08; }
  .prompt-copy { margin: 1.2rem 0 0; font-size: 1.05rem; line-height: 1.45; }
  .prompt-guidance { margin: 0.75rem 0 1.4rem; color: var(--ink-soft); font-size: 0.82rem; font-style: italic; line-height: 1.45; }
  .movement-field { margin: 0 0 1.1rem; border: 0; padding: 0; }
  .movement-field legend, .response-field > span, .student-name > span { font: 700 var(--record-tiny)/1.3 var(--sans); letter-spacing: 0.07em; text-transform: uppercase; }
  .movement-options { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; margin-top: 0.55rem; }
  .movement-options label { position: relative; display: flex; min-height: 2.55rem; align-items: center; border: 1px solid var(--line-dark); background: #fffdf7; cursor: pointer; }
