  .record-export > p { margin: 0.7rem 0 0; color: var(--ink-soft); font: var(--record-tiny)/1.45 var(--sans); }
  .preserve-dialog { width: min(28rem, calc(100vw - 2rem)); border: 1px solid var(--line-dark); border-radius: 0; background: var(--paper-light); color: var(--ink); padding: 0; box-shadow: 0 24px 80px rgb(0 0 0 / 38%); }
  .preserve-dialog::backdrop { background: rgb(3 6 9 / 67%); }
