  .preserve-button, .download-button { width: 100%; min-height: 2.75rem; border: 1px solid var(--ink); background: var(--ink); color: var(--paper-light); padding: 0.8rem 1rem; font: 700 var(--record-small)/1.3 var(--sans); letter-spacing: 0.07em; text-transform: uppercase; cursor: pointer; }
