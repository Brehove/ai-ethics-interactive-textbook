  .preserve-dialog h2 { margin: 0.45rem 0 0.8rem; font-size: 1.4rem; font-weight: 400; }
  .preserve-dialog p:not(.dialog-kicker) { font-size: 0.87rem; line-height: 1.5; }
  .preserve-dialog form > div { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; margin-top: 1.2rem; }
  .preserve-dialog button { min-height: 2.75rem; border: 1px solid var(--ink); background: transparent; color: var(--ink); padding: 0.7rem; font: 700 var(--record-tiny)/1.3 var(--sans); cursor: pointer; }
  .preserve-dialog [data-confirm-preserve] { background: var(--ink); color: var(--paper-light); }
  .reading-record-noscript { grid-column: 4; padding: 2rem; background: var(--paper-light); }

  .selection-note-button { position: fixed; z-index: 80; min-width: 6.2rem; min-height: 2.75rem; border: 1px solid var(--gold); background: var(--frame); color: var(--paper-deep); padding: 0.55rem 0.75rem; box-shadow: 0 8px 24px rgb(0 0 0 / 28%); font: 700 0.72rem/1.2 var(--sans); cursor: pointer; }
  .record-notes { margin-top: 1.8rem; padding-top: 1.25rem; border-top: 1px solid var(--line-dark); }
  .reading-record--pilot .record-notes { border-top: 3px solid #6f8da4; }
  .reading-record--pilot .record-notes .prompt-stage { color: #315d78; }
  .record-notes > header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .record-notes h2 { margin: 0.25rem 0 0; font-size: 1.3rem; font-weight: 400; }
  .record-notes > header button,
  .note-actions button,
  .note-list button { min-height: 2.75rem; border: 1px solid var(--line-dark); background: transparent; color: var(--ink); padding: 0.6rem 0.75rem; font: 700 var(--record-tiny)/1.25 var(--sans); cursor: pointer; }
  .notes-summary, .note-form #note-guidance, .note-anchor { color: var(--ink-soft); font: var(--record-tiny)/1.5 var(--sans); }
  .note-form { margin-top: 1rem; padding: 1rem; border: 1px solid var(--line); background: var(--paper); }
  .reading-record--pilot .note-form { border-color: #9cafbb; background: #eef1f2; }
