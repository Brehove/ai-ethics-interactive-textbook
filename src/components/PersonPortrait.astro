---
import type { PersonBundle } from "../lib/content";

interface Props {
  person: PersonBundle;
  variant?: "card" | "dock" | "page";
  showCredit?: boolean;
}

const { person, variant = "card", showCredit = true } = Astro.props;
const { portrait } = person;
const initials = person.displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toLocaleUpperCase("en"))
  .join("");
---

{portrait ? (
  <figure class:list={["person-portrait", `person-portrait--${variant}`]}>
    <img
      src={portrait.localPath}
      alt={portrait.alt}
      width={portrait.width}
      height={portrait.height}
      loading={variant === "page" ? "eager" : "lazy"}
      decoding="async"
    />
    {showCredit && (
      <figcaption>
        {portrait.caption && <span class="portrait-caption">{portrait.caption}</span>}
        <span class="portrait-credit">
          Image: <cite>{portrait.title}</cite> · {portrait.rights.artist}. {
            portrait.rights.licenseUrl
              ? <a href={portrait.rights.licenseUrl} rel="license noreferrer">{portrait.rights.licenseShortName}</a>
              : portrait.rights.licenseShortName
          }. Modified: {portrait.derivative.modification}. <a href={portrait.source.pageUrl} rel="noreferrer">Wikimedia Commons record</a>, reviewed revision {portrait.source.revisionId}.
        </span>
      </figcaption>
    )}
  </figure>
) : (
  <div class:list={["portrait-placeholder", `portrait-placeholder--${variant}`]} aria-hidden="true">
    <span>{initials}</span>
  </div>
)}

<style>
  .person-portrait { margin: 0; }
  .person-portrait img,
  .portrait-placeholder {
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 5;
    place-items: center;
    border: 1px solid var(--line-dark);
    background: linear-gradient(145deg, var(--wash-strong), var(--paper-deep));
  }
  .person-portrait img {
    height: auto;
    object-fit: cover;
    object-position: center top;
  }
  .portrait-placeholder span {
    color: var(--line-dark);
    font: 500 clamp(2.2rem, 7vw, 4.8rem)/1 var(--serif);
    letter-spacing: -0.08em;
  }
  figcaption {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.55rem;
    color: var(--ink-soft);
    font: 0.64rem/1.45 var(--sans);
  }
  .portrait-caption { color: var(--ink); font-family: var(--serif); font-size: 0.73rem; }
  .portrait-credit { overflow-wrap: anywhere; }
  .person-portrait--dock figcaption { padding-inline: 0.1rem; }
  .person-portrait--page,
  .portrait-placeholder--page { max-width: 30rem; }
</style>
