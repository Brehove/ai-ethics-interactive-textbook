  function renderSemanticReview() {
    type ReviewItem = { label: string; detail: string; tone?: "changed" | "added" | "removed" };
    const items: ReviewItem[] = [];
    const canonicalCheckpoints = new Map((canonicalChapter.checkpoints ?? []).map((item) => [item.slot, item]));
    const workingCheckpoints = new Map((chapter.checkpoints ?? []).map((item) => [item.slot, item]));
    for (const slot of slots) {
      const before = canonicalCheckpoints.get(slot); const after = workingCheckpoints.get(slot);
      if (!before && after) items.push({ label: `${slot} checkpoint`, detail: "Added to the working chapter", tone: "added" });
      else if (before && !after) items.push({ label: `${slot} checkpoint`, detail: "Removed from the working chapter", tone: "removed" });
      else if (before && after && JSON.stringify(before) !== JSON.stringify(after)) items.push({ label: `${slot} checkpoint`, detail: "Prompt, guidance, response, or anchor revised", tone: "changed" });
