        } else {
          const definition = providerDefinition(selectedMedia, mediaRef.value);
          await applyOperation({ type: "embed.upsert", position, embed: { kind: "externalEmbed", anchorPassageId: anchor.value, identity: definition.identity, canonicalUrl: definition.canonicalUrl, caption: mediaCaption.value, teachingUse: mediaCredit.value, displayPreset: "reading", theme: "auto", fallback: { title: mediaName.value, summary: mediaFallback.value, transcript: mediaTranscript.value || undefined, linkLabel: mediaLinkLabel.value, accessedAt: new Date().toISOString() }, adapterVersion: `${definition.identity.provider}-v1` } });
