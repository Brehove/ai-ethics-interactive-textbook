    nativeUpload.hidden = external; reviewAck.required = !external; mediaRefField.hidden = !external; mediaRef.required = external; mediaName.parentElement!.hidden = !external; mediaName.required = external; mediaIdField.hidden = external; mediaVersionField.hidden = external; rightsCaseField.hidden = external; captionField.hidden = linkCard; mediaCaption.required = !linkCard; altField.hidden = external; mediaAlt.required = !external; transcriptField.hidden = selectedMedia !== "Audio/Video"; fallbackField.hidden = !external; mediaFallback.required = external; linkLabelField.hidden = !external; mediaLinkLabel.required = external; providerPrivacy.hidden = !external; providerPrivacy.textContent = privacyCopy[selectedMedia] ?? "";
