    if (editable) setStatus(`Authenticated · ${chapter.title ?? selectedChapterId} loaded · change set ${changeSetId.slice(0, 8)} · version ${expectedVersion}.`);
    else { offline.hidden = false; offline.textContent = "Read-only: this chapter remains repository-authoritative until its controlled D1 cutover."; setStatus(`${chapter.title ?? selectedChapterId} loaded read-only. Browse and inspect it here; editing remains locked until cutover.`); }
