  const stablePosition = () => ({ afterBlockId: selectedBlockId || (chapter.body ?? []).find((block) => block.blockId)?.blockId || "" });
  function safePublicUrl(value: string) {
    let url: URL;
    try { url = new URL(value); } catch { throw new Error("Enter a complete public HTTPS URL"); }
    const host = url.hostname.toLowerCase();
    if (url.protocol !== "https:" || url.username || url.password || url.port || !host.includes(".") || host === "localhost" || host.includes(":") || /^(?:\d{1,3}\.){3}\d{1,3}$/.test(host) || /(?:^|\.)(?:local|internal|localhost)$/.test(host)) throw new Error("Only public HTTPS URLs without credentials or custom ports are accepted");
    url.hostname = host; url.hash = "";
    return url;
  }

  function providerDefinition(label: string, value: string) {
    const url = safePublicUrl(value); const parts = url.pathname.split("/").filter(Boolean); const host = url.hostname;
    if (label === "YouTube") {
      if (!["youtube.com", "www.youtube.com", "m.youtube.com", "youtu.be"].includes(host)) throw new Error("Use a public YouTube URL");
      const resourceId = host === "youtu.be" ? parts[0] : url.searchParams.get("v") || (["shorts", "embed", "live"].includes(parts[0]) ? parts[1] : "");
      if (!/^[A-Za-z0-9_-]{11}$/.test(resourceId ?? "")) throw new Error("Use a public YouTube video URL");
      return { identity: { provider: "youtube", resourceType: "video", resourceId }, canonicalUrl: `https://www.youtube.com/watch?v=${resourceId}` };
    }
    if (label === "Vimeo") {
      if (!["vimeo.com", "www.vimeo.com", "player.vimeo.com"].includes(host)) throw new Error("Use a public Vimeo URL");
      const resourceId = [...parts].reverse().find((part) => /^\d{6,12}$/.test(part)) || "";
      if (!resourceId) throw new Error("Use a public Vimeo video URL");
      return { identity: { provider: "vimeo", resourceType: "video", resourceId }, canonicalUrl: `https://vimeo.com/${resourceId}` };
    }
