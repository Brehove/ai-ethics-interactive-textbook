    checkpointTabs.replaceChildren(...slots.map((slot) => { const button = document.createElement("button"); const exists = Boolean(checkpointFor(slot)); button.type = "button"; button.dataset.slot = slot; button.textContent = `${exists ? "✓" : "+"} ${slot[0].toUpperCase()}${slot.slice(1)}`; button.disabled = !exists; button.addEventListener("click", () => selectCheckpoint(slot)); return button; }));
