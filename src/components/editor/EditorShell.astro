  submitReview.addEventListener("click", async () => { if (!contentOnline || dirty) { setStatus("Review submission requires an online, saved change set."); return; } try { const idempotencyKey = key(); const response = await post(`/v1/changesets/${encodeURIComponent(changeSetId)}:submitReview`, { baseRevisionId, expectedVersion, idempotencyKey }); const data = await response.json(); if (!response.ok) throw new Error(); showHumanReview(data); snapshotReceipt.hidden = false; snapshotReceipt.textContent = `Submitted immutable snapshot ${data.snapshotHash} at revision ${data.snapshotRevision}.`; setStatus("Submitted for human review. Approval remains a separate explicit action and does not publish."); } catch { setStatus("Review submission failed validation or the working version changed."); } });
