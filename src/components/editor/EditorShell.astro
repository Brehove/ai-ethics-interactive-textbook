  root.querySelectorAll<HTMLButtonElement>("[data-media]").forEach((button) => button.addEventListener("click", () => {
    selectedMedia = button.dataset.media ?? ""; mediaTitle.textContent = `Insert ${selectedMedia}`;
    mediaRef.value = ""; mediaName.value = ""; mediaId.value = ""; mediaVersionId.value = ""; rightsCaseId.value = ""; selectedExistingRightsStatus = ""; mediaSearch.value = ""; mediaKind.value = ""; mediaRights.value = "cleared"; mediaResults.replaceChildren(); rightsBasis.value = "owned"; rightsCreator.value = ""; rightsSource.value = ""; rightsLicense.value = ""; rightsAttribution.value = ""; reviewTeachingUse.value = ""; placementIntent.value = ""; decorative.checked = false; reviewAlt.value = ""; reviewAlt.required = true; reviewAltField.hidden = false; motionReview.value = "notApplicable"; captionLanguage.value = "en"; reviewTranscript.value = ""; posterAlt.value = ""; activeReviewPackageId = ""; activeReviewDeclarationHash = ""; activeReviewPackageState = ""; reviewPackageReceipt.hidden = true; reviewDecisionComment.value = ""; reviewPackageStatus.textContent = ""; mediaFile.value = ""; existingAsset.checked = false; reviewAck.checked = false; uploadProgress.textContent = ""; mediaCaption.value = ""; mediaAlt.value = ""; mediaCredit.value = ""; mediaTranscript.value = ""; mediaFallback.value = ""; mediaLinkLabel.value = selectedMedia === "Link card" ? "Open resource" : `Open on ${selectedMedia}`;
