      if (!["x.com", "www.x.com", "twitter.com", "www.twitter.com"].includes(host)) throw new Error("Use a public X post URL");
      const match = url.pathname.match(/^\/([A-Za-z0-9_]{1,15})\/status\/(\d{5,25})(?:\/.*)?$/);
      if (!match) throw new Error("Use the canonical URL for one public X post");
      return { identity: { provider: "x", resourceType: "post", resourceId: match[2] }, canonicalUrl: `https://x.com/${match[1]}/status/${match[2]}` };
    }
    if (label === "Spotify") {
      if (host !== "open.spotify.com") throw new Error("Use a canonical Spotify URL");
      const match = url.pathname.match(/^\/(track|album|playlist|episode|show)\/([A-Za-z0-9]{22})$/);
      if (!match) throw new Error("Use a canonical Spotify track, album, playlist, episode, or show URL");
      return { identity: { provider: "spotify", resourceType: match[1], resourceId: match[2] }, canonicalUrl: `https://open.spotify.com/${match[1]}/${match[2]}` };
    }
    if (label === "SoundCloud") {
      if (!["soundcloud.com", "www.soundcloud.com"].includes(host) || parts.length < 2) throw new Error("Use a canonical public SoundCloud creator and track URL, not a short link");
      const resourceId = parts.at(-1) ?? "";
      if (!/^[A-Za-z0-9._-]+$/.test(resourceId)) throw new Error("The SoundCloud track identity is invalid");
      return { identity: { provider: "soundcloud", resourceType: parts.at(-2) === "sets" ? "set" : "track", resourceId }, canonicalUrl: `https://soundcloud.com/${parts.join("/")}` };
    }
    if (label === "Bluesky") {
      if (host !== "bsky.app") throw new Error("Use a canonical public Bluesky post URL");
      const match = url.pathname.match(/^\/profile\/([a-z0-9][a-z0-9.-]{1,251})\/post\/([a-z0-9]+)$/i);
      if (!match) throw new Error("Use a canonical public Bluesky post URL");
      return { identity: { provider: "bluesky", resourceType: "post", resourceId: match[2] }, canonicalUrl: `https://bsky.app/profile/${match[1]}/post/${match[2]}` };
    }
    throw new Error("This provider is not available as a typed embed");
  }

  async function loadSelectedChapter() {
