  mediaFile.addEventListener("change", () => { const file = mediaFile.files?.[0]; activeReviewPackageId = ""; activeReviewDeclarationHash = ""; activeReviewPackageState = ""; reviewPackageReceipt.hidden = true; reviewPackageStatus.textContent = file ? "File changed. Create a pending review package for this exact declaration." : ""; gifNote.hidden = file?.type !== "image/gif"; const audioOrVideo = Boolean(file && (file.type.startsWith("audio/") || file.type.startsWith("video/"))); transcriptDeclaration.hidden = existingAsset.checked || !audioOrVideo; posterAltField.hidden = existingAsset.checked || !file?.type.startsWith("video/"); uploadProgress.textContent = file ? `${file.name} · ${file.type || "unknown MIME"} · ${file.size.toLocaleString()} bytes` : ""; });
