    if (insertedMedia) items.push({ label: `${insertedMedia} media or embed block${insertedMedia === 1 ? "" : "s"}`, detail: "Added to the working chapter", tone: "added" });
    if (removedBlocks) items.push({ label: `${removedBlocks} canonical block${removedBlocks === 1 ? "" : "s"}`, detail: "Absent from the working chapter", tone: "removed" });
