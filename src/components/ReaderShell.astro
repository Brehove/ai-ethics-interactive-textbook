---
import ModeNav from "./ModeNav.astro";
import ChapterActions from "./ChapterActions.astro";
import PrivacyNote from "./PrivacyNote.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug: string;
  title: string;
  partTitle: string;
  chapterNumber: number;
  readingMinutes: number;
  headings?: Heading[];
  active: "first" | "deep" | "sources" | "world";
  pressbooksUrl: string;
  previous?: { path: string; title: string } | null;
  next?: { path: string; title: string } | null;
}

const {
  slug,
  title,
  partTitle,
  chapterNumber,
  readingMinutes,
  headings = [],
  active,
  pressbooksUrl,
  previous,
  next,
} = Astro.props;
const chapterHeadings = headings.filter((heading) => heading.depth === 2);
---

<main id="main-content" class="reader-shell">
  <nav class="reading-rail" aria-label="Chapter path">
    <p class="eyebrow">Chapter path</p>
    <ol>
      {chapterHeadings.map((heading, index) => (
        <li><a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, "0")}</span>{heading.text}</a></li>
      ))}
    </ol>
    <p class="rail-note"><strong>Reading modes</strong><br />First Read keeps the prose quiet. Deep Read reveals the argumentative machinery. Sources opens the chapter's textual evidence. World situates the ideas historically.</p>
  </nav>

  <article class="reader-main">
    <ModeNav slug={slug} active={active} />
    <header class="reader-context">
      <p class="chapter-kicker">{partTitle}</p>
      {active !== "first" && <p class="layer-title">{active === "deep" ? "Argument layer" : active === "sources" ? "Primary texts and evidence" : "People, traditions, and context"}</p>}
    </header>
    <slot />

    <footer class="chapter-footer">
      <ChapterActions slug={slug} />
      <p class="copy-note">Chapter {chapterNumber} · approximately {readingMinutes} minutes · canonical title: {title}</p>
      <nav aria-label="Adjacent chapters">
        {previous ? <a href={previous.path}>← {previous.title}</a> : <span></span>}
        {next ? <a href={next.path}>{next.title} →</a> : <span></span>}
      </nav>
    </footer>
  </article>

  <aside class="source-dock" aria-label="Source dock">
    <div>
      <p class="eyebrow">Source dock</p>
      <h2>{active === "first" ? "Read with the sources nearby" : active === "deep" ? "Follow the argument" : active === "sources" ? "Open the evidence" : "Locate the tradition"}</h2>
      <p>{active === "first" ? "Move among reading layers without losing your place in the chapter." : active === "deep" ? "Reconstruct premises, objections, and revisions before deciding whether the argument succeeds." : active === "sources" ? "Source records distinguish the primary text, the edition or translation, and the chapter's interpretation." : "World records connect thinkers, concepts, institutions, and later inheritances without replacing the primary reading."}</p>
      <a class="source-link" href={pressbooksUrl}>Open this chapter in Pressbooks ↗</a>
    </div>
    <PrivacyNote />
  </aside>
</main>

<style>
  .reader-shell {
    min-height: calc(100vh - 4.2rem);
    display: grid;
    grid-template-columns: 15rem minmax(32rem, 1fr) minmax(19rem, 25rem);
    max-width: 98rem;
    margin: 0 auto;
    border-inline: 1px solid var(--line);
    background: var(--paper-light);
  }
  .reading-rail,
  .source-dock {
    position: sticky;
    top: 4.2rem;
    align-self: start;
    height: calc(100vh - 4.2rem);
    overflow: auto;
    background: var(--wash);
  }
  .reading-rail { padding: 2rem 1.35rem 2.5rem; border-right: 1px solid var(--line); }
  .reading-rail ol { list-style: none; margin: 1rem 0 0; padding: 0; }
  .reading-rail li { border-top: 1px solid rgb(120 149 158 / 42%); }
  .reading-rail li:last-child { border-bottom: 1px solid rgb(120 149 158 / 42%); }
  .reading-rail a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.3rem;
    padding: 0.8rem 0.15rem;
    font-size: 0.82rem;
    line-height: 1.25;
    text-decoration: none;
  }
  .reading-rail a span { font: 700 0.67rem/1.3 var(--sans); }
  .rail-note { margin-top: 2rem; color: var(--ink-soft); font: 0.71rem/1.5 var(--sans); }
  .reader-main {
    min-width: 0;
    padding: 1.4rem clamp(1.5rem, 5vw, 4.25rem) 5rem;
    background: linear-gradient(90deg, rgb(232 240 242 / 18%), transparent 8%, transparent 92%, rgb(232 240 242 / 15%));
  }
  .reader-context { margin: 1.65rem 0 0.75rem; }
  .chapter-kicker { margin: 0; color: var(--rust-dark); font: 700 0.68rem/1.3 var(--sans); letter-spacing: 0.15em; text-transform: uppercase; }
  .layer-title { margin: 0.4rem 0 0; color: var(--ink-soft); font-size: 1rem; font-style: italic; }
  .source-dock { padding: 2rem 1.5rem; border-left: 1px solid var(--line); }
  .source-dock h2 { margin: 1rem 0 0.7rem; font-size: 1.25rem; font-weight: 500; line-height: 1.2; }
  .source-dock p { font-size: 0.85rem; line-height: 1.55; }
  .source-link { display: inline-block; margin: 0.4rem 0 2rem; color: var(--rust-dark); font: 700 0.68rem/1.35 var(--sans); }
  .chapter-footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .copy-note { color: var(--ink-soft); font: 0.68rem/1.45 var(--sans); }
  .chapter-footer nav { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
  .chapter-footer nav a { font: 700 0.72rem/1.35 var(--sans); }
  .chapter-footer nav a:last-child { text-align: right; }
  @media (max-width: 1180px) {
    .reader-shell { grid-template-columns: minmax(32rem, 1fr) minmax(19rem, 23rem); }
    .reading-rail { display: none; }
  }
  @media (max-width: 820px) {
    .reader-shell { display: block; border: 0; }
    .reader-main { padding: 1rem 1.35rem 3rem; }
    .source-dock { position: static; height: auto; border: 0; border-top: 1px solid var(--line); }
    .chapter-footer nav { grid-template-columns: 1fr; }
    .chapter-footer nav a:last-child { text-align: left; }
  }
</style>
