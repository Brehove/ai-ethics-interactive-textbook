---
import ChapterActions from "./ChapterActions.astro";
import PrivacyNote from "./PrivacyNote.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  slug: string;
  title: string;
  partTitle: string;
  chapterNumber: number;
  readingMinutes: number;
  headings?: Heading[];
  active: "first" | "deep" | "sources" | "world";
  previous?: { path: string; title: string } | null;
  next?: { path: string; title: string } | null;
}

const {
  slug,
  title,
  partTitle,
  chapterNumber,
  readingMinutes,
  headings = [],
  active,
  previous,
  next,
} = Astro.props;
const chapterHeadings = headings.filter((heading) => heading.depth === 2);
const hasOutline = (active === "first" || active === "deep") && chapterHeadings.length > 0;
const hasScholarlyDock = Astro.slots.has("scholarly-dock");
function splitDisplayTitle(value: string): { heading: string; subtitle: string | null } {
  const questionBoundary = value.indexOf("? ");
  if (questionBoundary >= 0) {
    return { heading: value.slice(0, questionBoundary + 1), subtitle: value.slice(questionBoundary + 2) };
  }
  const colonBoundary = value.indexOf(": ");
  if (colonBoundary >= 0) {
    return { heading: value.slice(0, colonBoundary), subtitle: value.slice(colonBoundary + 2) };
  }
  return { heading: value, subtitle: null };
}
const displayTitle = splitDisplayTitle(title);
---

<main
  id="main-content"
  class="reader-shell"
  data-context-closed={active === "first" ? "true" : undefined}
>
  {hasOutline && (
    <button
      class="outline-toggle interactive-only"
      type="button"
      aria-controls="chapter-outline"
      aria-expanded="false"
      aria-label="Open chapter outline"
      data-outline-open
    >
      <span>In this chapter</span><b aria-hidden="true">›</b>
    </button>
  )}

  {hasOutline && (
    <nav id="chapter-outline" class="reading-rail interactive-only" aria-label="Chapter path" aria-hidden="true" inert data-chapter-outline>
      <header>
        <div><p class="eyebrow">In this chapter</p><p>{title}</p></div>
        <button type="button" aria-label="Close chapter outline" data-outline-close>×</button>
      </header>
      <ol>
        {chapterHeadings.map((heading, index) => (
          <li><a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, "0")}</span>{heading.text}</a></li>
        ))}
      </ol>
      <p class="rail-note">The outline stays out of the way until you need it. Selecting a section returns focus to the reading.</p>
    </nav>
  )}
  {hasOutline && <button class="outline-scrim interactive-only" type="button" aria-label="Close chapter outline" data-outline-scrim></button>}
  {hasOutline && (
    <noscript>
      <style>
        .outline-toggle, .reading-rail, .outline-scrim { display: none !important; }
      </style>
      <nav class="reading-rail-noscript" aria-label="Chapter path">
        <p class="eyebrow">In this chapter</p>
        <ol>
          {chapterHeadings.map((heading, index) => (
            <li><a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, "0")}</span>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    </noscript>
  )}

  <article class="reader-main">
    {active !== "first" && <a class="back-to-chapter" href={`/chapter/${slug}/`}>← Return to chapter</a>}
    <header class="reader-context">
      <p class="chapter-kicker">Chapter {chapterNumber}</p>
      <p class="visually-hidden">{partTitle}</p>
      <h1 class="reader-title">{displayTitle.heading}</h1>
      {displayTitle.subtitle && <p class="reader-subtitle">{displayTitle.subtitle}</p>}
      {active !== "first" && <p class="layer-title">{active === "deep" ? "Argument layer" : active === "sources" ? "Primary texts and evidence" : "People, traditions, and context"}</p>}
    </header>
    <slot />

    <footer class="chapter-footer">
      <ChapterActions slug={slug} />
      <p class="copy-note">Chapter {chapterNumber} · approximately {readingMinutes} minutes · canonical title: {title}</p>
      <nav aria-label="Adjacent chapters">
        {previous ? <a href={previous.path}>← {previous.title}</a> : <span></span>}
        {next ? <a href={next.path}>{next.title} →</a> : <span></span>}
      </nav>
    </footer>
  </article>

  <div class="pane-gutter" aria-hidden="true"></div>

  {hasScholarlyDock ? (
    <slot name="scholarly-dock" />
  ) : (
    <aside class="source-dock" aria-label="Source dock">
      <div>
        <p class="eyebrow">Source dock</p>
        <h2>{active === "first" ? "Read with the sources nearby" : active === "deep" ? "Follow the argument" : active === "sources" ? "Open the evidence" : "Locate the tradition"}</h2>
        <p>{active === "first" ? "Move among reading layers without losing your place in the chapter." : active === "deep" ? "Reconstruct premises, objections, and revisions before deciding whether the argument succeeds." : active === "sources" ? "Source records distinguish the primary text, the edition or translation, and the chapter's interpretation." : "World records connect thinkers, concepts, institutions, and later inheritances without replacing the primary reading."}</p>
        <a class="source-link" href={`/chapter/${slug}/sources/`}>Open this chapter's sources →</a>
      </div>
      <PrivacyNote />
    </aside>
  )}
</main>

<script>
  document.querySelectorAll<HTMLElement>(".reader-shell").forEach((shell) => {
    const outline = shell.querySelector<HTMLElement>("[data-chapter-outline]");
    const openOutline = shell.querySelector<HTMLButtonElement>("[data-outline-open]");
    const closeOutline = shell.querySelector<HTMLButtonElement>("[data-outline-close]");
    const scrim = shell.querySelector<HTMLButtonElement>("[data-outline-scrim]");
    let outlineReturnFocus: HTMLElement | null = null;

    const setOutline = (open: boolean) => {
      shell.toggleAttribute("data-outline-visible", open);
      openOutline?.setAttribute("aria-expanded", String(open));
      outline?.toggleAttribute("inert", !open);
      outline?.setAttribute("aria-hidden", String(!open));
      if (open) {
        outlineReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        closeOutline?.focus({ preventScroll: true });
      } else {
        outlineReturnFocus?.focus({ preventScroll: true });
        outlineReturnFocus = null;
      }
    };

    openOutline?.addEventListener("click", () => setOutline(true));
    closeOutline?.addEventListener("click", () => setOutline(false));
    scrim?.addEventListener("click", () => setOutline(false));
    outline?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOutline(false)));

    shell.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const closeControl = target?.closest<HTMLElement>("[data-context-close]");
      if (closeControl) {
        shell.setAttribute("data-context-closed", "true");
        shell.removeAttribute("data-context-mobile-open");
        if (!closeControl.hasAttribute("data-context-close-own-focus")) {
          shell.querySelector<HTMLButtonElement>("[data-judgment-trigger] button")?.focus({ preventScroll: true });
        }
      }
    });

    document.addEventListener("keydown", (event) => {
      if (!shell.hasAttribute("data-outline-visible")) return;
      if (event.key === "Escape") {
        setOutline(false);
        return;
      }
      if (event.key !== "Tab" || !outline) return;
      const focusable = Array.from(outline.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      )).filter((element) => !element.hasAttribute("hidden"));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || !outline.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !outline.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    });
  });
</script>

<style>
  .reader-shell {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: grid;
    grid-template-columns: var(--chapter-rail) minmax(0, 1fr) var(--pane-gutter) minmax(21rem, 35vw);
    width: 100%;
    padding: 0 var(--frame-size) var(--frame-size);
    background: var(--frame);
  }
  .outline-toggle {
    position: sticky;
    z-index: 28;
    top: var(--header-height);
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    display: grid;
    width: 100%;
    min-height: 11rem;
    place-items: center;
    border: 1px solid var(--frame-line);
    border-block: 0;
    border-left: 0;
    background: var(--frame);
    color: var(--paper-deep);
    padding: 0.65rem 0.25rem;
    cursor: pointer;
  }
  .outline-toggle span { writing-mode: vertical-rl; font-size: 0.78rem; letter-spacing: 0.03em; }
  .outline-toggle b { font-size: 1.35rem; font-weight: 400; }
  .reading-rail {
    position: fixed;
    z-index: 42;
    left: var(--frame-size);
    top: var(--header-height);
    width: min(23rem, calc(100vw - 2rem));
    height: calc(100dvh - var(--header-height) - var(--frame-size));
    overflow: auto;
    transform: translateX(calc(-100% - var(--frame-size)));
    border: 1px solid var(--frame-line);
    border-left: 0;
    background: var(--frame);
    color: var(--paper-deep);
    padding: 1.25rem 1.35rem 2rem;
    transition: transform 180ms ease;
  }
  [data-outline-visible] .reading-rail { transform: translateX(0); }
  .reading-rail header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--frame-line); }
  .reading-rail header p:last-child { margin: 0.45rem 0 0; color: var(--paper-deep); font-size: 1.05rem; line-height: 1.25; }
  .reading-rail header button { border: 0; background: transparent; color: inherit; font-size: 1.7rem; cursor: pointer; }
  .reading-rail ol { list-style: none; margin: 1rem 0 0; padding: 0; }
  .reading-rail li { border-top: 1px solid var(--frame-line); }
  .reading-rail li:last-child { border-bottom: 1px solid var(--frame-line); }
  .reading-rail a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.3rem;
    padding: 0.8rem 0.15rem;
    color: var(--paper-deep);
    font-size: 0.82rem;
    line-height: 1.25;
    text-decoration: none;
  }
  .reading-rail a:hover { color: var(--gold); }
  .reading-rail a span { color: var(--gold); font: 700 0.67rem/1.3 var(--sans); }
  .rail-note { margin-top: 2rem; color: #b9af9f; font: 0.71rem/1.5 var(--sans); }
  .reading-rail-noscript { max-width: var(--content-width); margin: 1.5rem 0 0; padding: 1rem 1.2rem; border: 1px solid var(--line); background: var(--wash); }
  .reading-rail-noscript ol { margin: 0.75rem 0 0; padding-left: 1.25rem; }
  .reading-rail-noscript li + li { margin-top: 0.35rem; }
  .reading-rail-noscript span { margin-right: 0.45rem; color: var(--rust); font: 700 0.67rem/1.3 var(--sans); }
  .outline-scrim { position: fixed; z-index: 41; inset: 0; display: none; border: 0; background: rgb(0 0 0 / 52%); cursor: default; }
  [data-outline-visible] .outline-scrim { display: block; }
  .reader-main {
    grid-column: 2;
    min-width: 0;
    min-height: calc(100vh - var(--header-height) - var(--frame-size));
    padding: 0 clamp(1.6rem, 5vw, 4.8rem) 5rem;
    background: var(--paper-light);
  }
  .pane-gutter { grid-column: 3; min-height: 100%; background: var(--frame); }
  .reader-context { max-width: var(--content-width); margin: 1.55rem 0 0.55rem; }
  .back-to-chapter { display: inline-block; margin-top: 1rem; color: var(--rust-dark); font: 700 0.64rem/1.3 var(--sans); letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; }
  .chapter-kicker { margin: 0; color: var(--rust); font: 700 0.72rem/1.3 var(--sans); letter-spacing: 0.15em; text-transform: uppercase; }
  .reader-title { max-width: 18ch; margin: 0.55rem 0 0; font-size: clamp(3.15rem, 4.6vw, 4.8rem); font-weight: 400; line-height: 0.96; letter-spacing: -0.045em; overflow-wrap: anywhere; text-wrap: balance; }
  .reader-subtitle { margin: 0.55rem 0 1.15rem; color: var(--ink); font-size: clamp(1.15rem, 2vw, 1.55rem); font-style: italic; line-height: 1.25; }
  .layer-title { margin: 0.4rem 0 0; color: var(--ink-soft); font-size: 1rem; font-style: italic; }
  .source-dock { position: sticky; top: var(--header-height); grid-column: 4; align-self: start; height: calc(100vh - var(--header-height) - var(--frame-size)); overflow: auto; padding: 2rem 1.5rem; background: var(--paper-light); }
  .source-dock h2 { margin: 1rem 0 0.7rem; font-size: 1.25rem; font-weight: 500; line-height: 1.2; }
  .source-dock p { font-size: 0.85rem; line-height: 1.55; }
  .source-link { display: inline-block; margin: 0.4rem 0 2rem; color: var(--rust-dark); font: 700 0.68rem/1.35 var(--sans); }
  .chapter-footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .copy-note { color: var(--ink-soft); font: 0.68rem/1.45 var(--sans); }
  .chapter-footer nav { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
  .chapter-footer nav a { font: 700 0.72rem/1.35 var(--sans); }
  .chapter-footer nav a:last-child { text-align: right; }
  .reader-shell[data-context-closed] { grid-template-columns: var(--chapter-rail) minmax(0, 1fr) 0 0; }
  .reader-shell[data-context-closed] .pane-gutter,
  .reader-shell[data-context-closed] :global(#context-panel),
  .reader-shell[data-context-closed] :global(.scholarly-layer) { display: none; }
  @media (max-width: 1180px) {
    .reader-shell { grid-template-columns: var(--chapter-rail) minmax(0, 1fr) clamp(1.65rem, 2.7vw, 2.2rem) minmax(19rem, 35vw); }
    .reader-main { padding-inline: clamp(2rem, 4vw, 3.4rem); }
  }
  @media (max-width: 900px) {
    .reader-shell { grid-template-columns: var(--chapter-rail) minmax(0, 1fr); padding-inline: var(--frame-size); }
    .reader-main { grid-column: 2; min-height: 0; padding: 0 1.35rem 3rem; }
    .outline-toggle { grid-column: 1; width: 100%; min-height: 9.5rem; }
    .pane-gutter { display: none; }
    .source-dock { position: static; grid-column: 2; height: auto; margin-top: var(--pane-gutter); border: 0; }
    .chapter-footer nav { grid-template-columns: 1fr; }
    .chapter-footer nav a:last-child { text-align: left; }
  }
</style>
