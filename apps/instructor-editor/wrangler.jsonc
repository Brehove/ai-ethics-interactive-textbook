{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ai-ethics-instructor-editor",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "editor.ethicsandai.your-digital-life.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
