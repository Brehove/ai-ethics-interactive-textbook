{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Ethics Content API",
    "version": "1.7.0",
    "description": "Frozen agent-native authoring contract. Browser sessions use secure cookies; agents forward instructor-issued, short-lived, revocable bearer capabilities whose document and operation allowlists are reverified by the private auth service. Review and protected release operations remain human or service only."
  },
  "servers": [{ "url": "https://auth.ethicsandai.your-digital-life.org" }],
  "security": [{ "browserSession": [] }, { "bearerAuth": [] }],
  "x-rate-limits": {
    "persistence": "D1 fail-closed fixed window",
    "key": "trusted actor plus client",
    "windowSeconds": 60,
    "mutation": 120,
    "upload": 20
  },
  "paths": {
    "/health": { "get": { "security": [], "operationId": "health", "responses": { "200": { "description": "Binding-aware health" } } } },
    "/v1/schema": { "get": { "operationId": "getSchema", "x-agent-safe": true, "x-required-scopes": ["content:read"], "responses": { "200": { "description": "Runtime operation, provider, upload, review, release, and rate-limit contract" } } } },
    "/v1/chapters": { "get": { "operationId": "listChapters", "x-agent-safe": true, "x-required-scopes": ["content:read"], "responses": { "200": { "description": "Active canonical chapters" } } } },
    "/v1/chapters/{chapterId}": { "get": { "operationId": "getChapter", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/chapterId" }], "responses": { "200": { "description": "One revision-bound canonical chapter" } } } },
    "/v1/chapters/{chapterId}/authoring-view": { "get": { "operationId": "getAuthoringView", "x-agent-safe": true, "x-required-scopes": ["content:read"], "x-revision-bound": true, "parameters": [{ "$ref": "#/components/parameters/chapterId" }], "responses": { "200": { "description": "Canonical D1-authoritative chapter plus frozen renderer, checkpoint, and media projection" }, "409": { "description": "Chapter is not D1-authoritative" } } } },
    "/v1/documents/{chapterId}": { "get": { "operationId": "getDocumentAlias", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/chapterId" }], "responses": { "200": { "description": "Compatibility alias for the canonical chapter read" } } } },
    "/v1/chapters/{chapterId}/passages": { "get": { "operationId": "listPassages", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/chapterId" }, { "$ref": "#/components/parameters/limit100" }, { "$ref": "#/components/parameters/cursor" }], "responses": { "200": { "description": "Bounded stable-passage projections" } } } },
    "/v1/chapters/{chapterId}/passages/{passageId}": { "get": { "operationId": "getPassage", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/chapterId" }, { "$ref": "#/components/parameters/passageId" }], "responses": { "200": { "description": "One stable revision-bound passage" } } } },
    "/v1/chapters/{chapterId}/dependencies": { "get": { "operationId": "getChapterDependencies", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/chapterId" }, { "name": "passageId", "in": "query", "schema": { "$ref": "#/components/schemas/identifier" } }, { "$ref": "#/components/parameters/limit100" }, { "$ref": "#/components/parameters/cursor" }], "responses": { "200": { "description": "Bounded revision-bound dependency graph, optionally filtered to one passage" } } } },
    "/v1/chapters/{chapterId}/changesets": { "post": { "operationId": "createOrResumeChangeset", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/chapterId" }], "requestBody": { "$ref": "#/components/requestBodies/createChangeset" }, "responses": { "200": { "description": "Existing open, submitted, or approved changeset resumed" }, "201": { "description": "Draft changeset created" } } } },
    "/v1/changesets": { "post": { "operationId": "createMultiDocumentChangeset", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "x-atomic-working-copy": true, "requestBody": { "$ref": "#/components/requestBodies/createMultiDocumentChangeset" }, "responses": { "201": { "description": "One isolated changeset with a working copy for every target" }, "409": { "description": "At least one target is not D1-authoritative" } } } },
    "/v1/chapters/{chapterId}/revisions": { "get": { "operationId": "listChapterRevisions", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/chapterId" }, { "$ref": "#/components/parameters/limit50" }, { "$ref": "#/components/parameters/cursor" }], "responses": { "200": { "description": "Bounded content-free immutable revision history" } } } },
    "/v1/chapters/{chapterId}/revisions/{revisionId}:restoreAsDraft": { "post": { "operationId": "restoreRevisionAsDraft", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/chapterId" }, { "$ref": "#/components/parameters/revisionId" }], "responses": { "201": { "description": "Historical revision copied into a new draft based on current canonical head" } } } },
    "/v1/changesets/{changesetId}": { "get": { "operationId": "getChangeset", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "responses": { "200": { "description": "Working documents plus immutable submitted snapshot and human release decision when present" } } } },
    "/v1/changesets/{changesetId}:apply": { "post": { "operationId": "applySemanticOperation", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "requestBody": { "$ref": "#/components/requestBodies/mutationEnvelope" }, "responses": { "200": { "description": "CAS-bound semantic operation result" } } } },
    "/v1/changesets/{changesetId}/operations:batch": { "post": { "operationId": "applySemanticOperationBatch", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "x-atomic-working-copy": true, "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "requestBody": { "$ref": "#/components/requestBodies/operationBatch" }, "responses": { "200": { "description": "One CAS-bound working-version advance containing 1 to 100 semantic operations" }, "409": { "description": "Canonical head or working version changed" } } } },
    "/v1/changesets/{changesetId}:validate": { "post": { "operationId": "validateChangeset", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "responses": { "200": { "description": "Publishability validation result" } } } },
    "/v1/changesets/{changesetId}:saveLive": { "post": { "operationId": "saveLiveRevision", "x-agent-safe": true, "x-required-scopes": ["content:write", "content:live-save"], "x-human-alternative": { "requiredScopes": ["content:write"] }, "x-rate-limit-class": "mutation", "x-immutable-revision": true, "x-immediate-public-effect": true, "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "responses": { "201": { "description": "Validated D1-authoritative chapter saved as a new immutable canonical public revision" }, "403": { "description": "Agent capability lacks explicit live-save authority" }, "409": { "description": "Authority or revision precondition changed" } } } },
    "/v1/changesets/{changesetId}:commitLive": { "post": { "operationId": "commitLive", "x-agent-safe": true, "x-required-scopes": ["content:write", "content:live-save"], "x-human-alternative": { "requiredScopes": ["content:write"] }, "x-rate-limit-class": "mutation", "x-atomic-d1-batch": true, "x-immediate-public-effect": true, "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "requestBody": { "$ref": "#/components/requestBodies/commitLive" }, "responses": { "200": { "description": "No-op receipt and verified unchanged public projection" }, "201": { "description": "Atomic commit and matching public delivery verified" }, "202": { "description": "Atomic commit succeeded; public delivery confirmation pending" }, "409": { "description": "Idempotency key, authority, canonical head, or working version conflict" } } } },
    "/v1/live-commits/{commitReceiptId}": { "get": { "operationId": "getLiveCommitStatus", "x-agent-safe": true, "x-required-scopes": ["content:read"], "x-status-window-hours": 24, "parameters": [{ "name": "commitReceiptId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } }], "responses": { "200": { "description": "Matching public delivery verified" }, "202": { "description": "Public delivery remains confirmation pending" }, "410": { "description": "The 24-hour delivery-status window expired; immutable revision history remains available" } } } },
    "/v1/changesets/{changesetId}:diff": { "post": { "operationId": "diffChangeset", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "requestBody": { "$ref": "#/components/requestBodies/documentSelector" }, "responses": { "200": { "description": "Bounded semantic diff for one selected document or every changeset document, without chapter prose duplication" } } } },
    "/v1/changesets/{changesetId}:renderPreview": { "post": { "operationId": "renderPreview", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-rate-limit-class": "mutation", "x-preview-properties": { "immutableSnapshot": true, "oneTime": true, "ttlSeconds": 300, "authoringCredentials": false }, "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "requestBody": { "$ref": "#/components/requestBodies/previewRequest" }, "responses": { "201": { "description": "Immutable short-lived one-time protected draft preview" } } } },
    "/v1/changesets/{changesetId}:submitReview": { "post": { "operationId": "submitChangeset", "x-agent-safe": true, "x-required-scopes": ["content:submit"], "x-rate-limit-class": "mutation", "x-all-target-cas": true, "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "requestBody": { "$ref": "#/components/requestBodies/submitChangeset" }, "responses": { "201": { "description": "Immutable hash-addressed snapshot containing every changeset document" }, "409": { "description": "At least one canonical head or working version is stale; nothing is submitted" } } } },
    "/v1/changesets/{changesetId}:approve": { "post": { "operationId": "approveChangeset", "x-human-only": true, "x-required-scopes": ["content:approve"], "x-exact-snapshot-binding": true, "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "responses": { "201": { "description": "Human approval of exact submitted hash and revision" } } } },
    "/v1/changesets/{changesetId}:reject": { "post": { "operationId": "rejectChangeset", "x-human-only": true, "x-required-scopes": ["content:approve"], "x-exact-snapshot-binding": true, "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "responses": { "201": { "description": "Human rejection with required reason" } } } },
    "/v1/changesets/{changesetId}:publish": { "post": { "operationId": "publishChangeset", "x-human-only": true, "x-required-scopes": ["content:publish"], "x-exact-snapshot-binding": true, "x-rate-limit-class": "mutation", "x-enabled": false, "x-disabled-reason": "Production traffic changes only through the protected release-workflow staging and receipt routes", "parameters": [{ "$ref": "#/components/parameters/changesetId" }], "responses": { "503": { "description": "Direct publication is fail-closed; the protected GitHub release workflow is the only promotion path" } } } },
    "/v1/media": { "get": { "operationId": "searchMedia", "x-agent-safe": true, "x-required-any-scope": ["media:read", "content:read"], "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 100 } }, { "name": "kind", "in": "query", "schema": { "type": "string", "enum": ["image", "audio", "video", "document"] } }, { "name": "rightsStatus", "in": "query", "schema": { "type": "string", "enum": ["reviewRequired", "cleared", "blocked"] } }, { "name": "sha256", "in": "query", "schema": { "$ref": "#/components/schemas/sha256" } }, { "$ref": "#/components/parameters/limit50" }, { "$ref": "#/components/parameters/cursor" }], "responses": { "200": { "description": "Reusable ready media versions" } } } },
    "/v1/media/{mediaId}/versions/{mediaVersionId}/rights/{rightsCaseId}:preview": { "get": { "operationId": "getManagedMediaPreview", "x-agent-safe": false, "x-browser-only": true, "x-required-any-scope": ["media:read", "content:read"], "x-cache-policy": "private, no-store", "parameters": [{ "$ref": "#/components/parameters/mediaId" }, { "name": "mediaVersionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } }, { "name": "rightsCaseId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } }], "responses": { "200": { "description": "Hash-verified immutable image derivative for the authenticated editor canvas" }, "404": { "description": "Exact version is not cleared or has no approved visual derivative" } } } },
    "/v1/persons": { "get": { "operationId": "searchCuratedPersons", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string", "maxLength": 100 } }, { "$ref": "#/components/parameters/limit50" }, { "$ref": "#/components/parameters/cursor" }], "responses": { "200": { "description": "Frozen curated person projections available for managed placement" } } } },
    "/v1/persons/{personId}": { "get": { "operationId": "getCuratedPerson", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "name": "personId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } }], "responses": { "200": { "description": "One immutable curated person projection" }, "404": { "description": "Curated person not found" } } } },
    "/v1/media-review-packages": { "post": { "operationId": "createMediaReviewPackage", "x-agent-safe": true, "x-required-any-scope": ["media:upload", "content:write"], "x-result-state": "pending", "x-rate-limit-class": "mutation", "responses": { "201": { "description": "Server-issued pending review package and declaration hash" } } } },
    "/v1/media-review-packages/{reviewPackageId}:decide": { "post": { "operationId": "decideMediaReviewPackage", "x-human-only": true, "x-required-scopes": ["content:approve"], "x-exact-declaration-binding": true, "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/reviewPackageId" }], "responses": { "200": { "description": "Human clearance or block decision" } } } },
    "/v1/media:requestUpload": { "post": { "operationId": "requestMediaUpload", "x-agent-safe": true, "x-required-scopes": ["media:upload"], "x-rate-limit-class": "upload", "x-media-policy": { "reviewPackageId": "server-issued", "audioVideoTranscriptEquivalent": "required and substantive; not a timed-caption claim", "videoPoster": "required", "maximumBytes": 26214400 }, "responses": { "201": { "description": "Bounded one-time upload ticket" } } } },
    "/v1/media/uploads/{ticketId}": { "put": { "operationId": "uploadMediaBytes", "x-agent-safe": true, "x-required-scopes": ["media:upload"], "x-rate-limit-class": "upload", "parameters": [{ "$ref": "#/components/parameters/ticketId" }], "responses": { "202": { "description": "Hash-verified bytes quarantined and immutable job queued" } } } },
    "/v1/media/jobs/{jobId}": { "get": { "operationId": "getMediaJob", "x-agent-safe": true, "x-required-any-scope": ["media:read", "content:read"], "parameters": [{ "$ref": "#/components/parameters/jobId" }], "responses": { "200": { "description": "Media-processing job state" } } } },
    "/v1/media/{mediaId}": { "get": { "operationId": "getMediaAsset", "x-agent-safe": true, "x-required-any-scope": ["media:read", "content:read"], "parameters": [{ "$ref": "#/components/parameters/mediaId" }], "responses": { "200": { "description": "Finalized immutable media versions and rights states" } } } },
    "/v1/embeds:resolve": { "post": { "operationId": "resolveEmbed", "x-agent-safe": true, "x-required-scopes": ["content:write"], "x-network-access": false, "responses": { "200": { "description": "Server-registry embed identity or authored rich-link proposal" } } } },
    "/v1/media:processorCallback": { "post": { "operationId": "processorCallback", "security": [{ "processorHmac": [] }], "x-service-only": true, "responses": { "201": { "description": "Verified media manifest promoted after processing" } } } },
    "/v1/release-snapshots/{snapshotHash}": { "get": { "operationId": "getReleaseSnapshot", "x-release-service-only": true, "x-required-scopes": ["content:releaseSnapshot"], "x-exact-sha256-bytes": true, "parameters": [{ "$ref": "#/components/parameters/snapshotHash" }], "responses": { "200": { "description": "Exact human-approved immutable submitted snapshot" } } } },
    "/v1/release-assets/{sha256}": { "get": { "operationId": "getReleaseAsset", "x-release-service-only": true, "x-required-scopes": ["content:releaseSnapshot"], "x-exact-sha256-bytes": true, "parameters": [{ "$ref": "#/components/parameters/sha256Path" }], "responses": { "200": { "description": "Exact approved snapshot-referenced immutable derivative" } } } },
    "/v1/releases/{releaseId}": { "get": { "operationId": "getReleaseMetadata", "x-agent-safe": true, "x-required-scopes": ["content:read"], "parameters": [{ "$ref": "#/components/parameters/releaseId" }], "responses": { "200": { "description": "Frozen release, authority, approval, and active-pointer metadata" } } } },
    "/v1/release-deployments:stage": { "post": { "operationId": "stageReleaseDeployment", "x-service-only": true, "x-required-scopes": ["content:deployReceipt"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "requestBody": { "$ref": "#/components/requestBodies/stageDeployment" }, "responses": { "201": { "description": "Exact approved candidate staged against the expected active release" }, "409": { "description": "Stale active release, missing exact approval, or another staged transaction" } } } },
    "/v1/release-deployments:pending": { "post": { "operationId": "getPendingReleaseDeployment", "x-service-only": true, "x-required-scopes": ["content:deployReceipt"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-content-free": true, "responses": { "200": { "description": "Pending staged transaction and exact target/recovery version bindings, or null" } } } },
    "/v1/release-deployments/{transactionId}:recordReceipt": { "post": { "operationId": "recordDeploymentReceipt", "x-service-only": true, "x-required-scopes": ["content:deployReceipt"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "x-active-pointer-cas": true, "parameters": [{ "$ref": "#/components/parameters/transactionId" }], "requestBody": { "$ref": "#/components/requestBodies/deploymentReceipt" }, "responses": { "201": { "description": "Hash-bound deployment receipt recorded and active pointer advanced atomically" }, "409": { "description": "Receipt binding, expiry, or expected-active CAS conflict" } } } },
    "/v1/release-deployments/{transactionId}:reconcileReceipt": { "post": { "operationId": "reconcileDeploymentReceipt", "x-service-only": true, "x-required-scopes": ["content:deployReceipt"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "x-active-pointer-cas": true, "x-allows-expired-staged-transaction": true, "parameters": [{ "$ref": "#/components/parameters/transactionId" }], "requestBody": { "$ref": "#/components/requestBodies/deploymentReceipt" }, "responses": { "201": { "description": "Exact live target version reconciled into the receipt and active pointer" }, "409": { "description": "Live binding or expected-active state is ambiguous" } } } },
    "/v1/release-deployments/{transactionId}:abandon": { "post": { "operationId": "abandonDeploymentTransaction", "x-service-only": true, "x-required-scopes": ["content:deployReceipt"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "x-requires-exact-recovery-version": true, "parameters": [{ "$ref": "#/components/parameters/transactionId" }], "requestBody": { "$ref": "#/components/requestBodies/abandonDeployment" }, "responses": { "200": { "description": "Untouched staged transaction abandoned after exact recovery-version observation" }, "409": { "description": "Traffic moved or live version is ambiguous" } } } },
    "/v1/releases/{releaseId}:stageRollback": { "post": { "operationId": "stageReleaseRollback", "x-service-only": true, "x-required-scopes": ["content:deployReceipt"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "parameters": [{ "$ref": "#/components/parameters/releaseId" }], "requestBody": { "$ref": "#/components/requestBodies/stageRollback" }, "responses": { "201": { "description": "Previously promoted immutable version staged as rollback target" }, "409": { "description": "Target is invalid, already active, or expected-active is stale" } } } },
    "/v1/releases/{releaseId}:auditState": { "post": { "operationId": "auditReleaseState", "x-service-only": true, "x-required-scopes": ["content:authority"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-complete-authority-map": true, "x-canonical-head-binding": true, "parameters": [{ "$ref": "#/components/parameters/releaseId" }], "responses": { "200": { "description": "Active pointer, published release, complete 18-document authority map, and D1 canonical heads match" }, "409": { "description": "Content-free structured mismatch report" } } } },
    "/v1/authority:prepareCutover": { "post": { "operationId": "prepareD1AuthorityCutover", "x-service-only": true, "x-required-scopes": ["content:authority"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "x-read-only-proposal": true, "requestBody": { "$ref": "#/components/requestBodies/createMultiDocumentChangeset" }, "responses": { "201": { "description": "Immutable working copies of currently Git-authoritative chapters prepared for human review" }, "409": { "description": "A target is not currently Git-authoritative" } } } },
    "/v1/authority:activateD1": { "post": { "operationId": "activateD1AuthorityBatch", "x-service-only": true, "x-required-scopes": ["content:authority"], "x-required-identity": { "actorType": "service", "actorId": "actor_release_workflow", "clientId": "github-content-release" }, "x-rate-limit-class": "mutation", "x-exact-active-release-binding": true, "x-database-guarded": true, "requestBody": { "$ref": "#/components/requestBodies/activateD1Authority" }, "responses": { "201": { "description": "Exact active-release revisions switched to D1 authority in one batch" }, "409": { "description": "Active release, canonical head, hash, or release authority entry does not match" } } } },
    "/v1/authority/chapter_ch07:activateD1": { "post": { "operationId": "activateChapter7D1Authority", "x-service-only": true, "x-required-scopes": ["content:authority"], "x-fixed-canary": "chapter_ch07", "x-rate-limit-class": "mutation", "x-exact-active-release-binding": true, "responses": { "201": { "description": "Hash-, revision-, and active-release-bound Chapter 7 authority activation" } } } }
  },
  "components": {
    "securitySchemes": {
      "browserSession": { "type": "apiKey", "in": "cookie", "name": "__Host-editor_session" },
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "processorHmac": { "type": "apiKey", "in": "header", "name": "x-media-signature" }
    },
    "schemas": {
      "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "uuid": { "type": "string", "format": "uuid" }
    },
    "parameters": {
      "chapterId": { "name": "chapterId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "passageId": { "name": "passageId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "revisionId": { "name": "revisionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "changesetId": { "name": "changesetId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "reviewPackageId": { "name": "reviewPackageId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "ticketId": { "name": "ticketId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "jobId": { "name": "jobId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "mediaId": { "name": "mediaId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "releaseId": { "name": "releaseId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
      "transactionId": { "name": "transactionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/identifier" } },
